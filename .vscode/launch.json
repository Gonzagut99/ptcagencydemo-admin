{
	"version": "0.2.0",
	"configurations": [
		{
			"name": "Debug Vite Dev Server",
			"type": "node",
			"request": "attach",
			"port": 9229,
			"restart": true,
			"skipFiles": ["<node_internals>/**"],
			"preLaunchTask": "npm: dev with inspector"
		},
		{
			"name": "Debug Client in Chrome",
			"type": "pwa-chrome",
			"request": "launch",
			"url": "http://localhost:5173",
			"webRoot": "${workspaceFolder}",
			"sourceMaps": true,
			"sourceMapPathOverrides": {
				"webpack:///./*": "${webRoot}/*",
				"webpack:///src/*": "${webRoot}/src/*",
				"vite-app:///src/*": "${webRoot}/src/*",
				"/@fs/*": "${workspaceFolder}/*",
				"/src/*": "${workspaceFolder}/src/*"
			},
			"smartStep": false
		}
	],
	"compounds": [
		{
				"name": "Full stack debug",
				"configurations": ["Debug Vite Dev Server", "Debug Client in Chrome"],
				"stopAll": true
		}
	]
}
